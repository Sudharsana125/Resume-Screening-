# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://resume_user:resume_pass@localhost:5432/resume_screening

# Embedding model used for semantic similarity ranking.
# Any sentence-transformers model works; MiniLM is fast, use a larger
# RoBERTa/BERT-based one (e.g. all-roberta-large-v1) for higher accuracy.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Weighting between semantic similarity and keyword/skill overlap
# when computing the final candidate score (must sum to 1.0)
SEMANTIC_WEIGHT=0.65
SKILL_OVERLAP_WEIGHT=0.35

# Directory where uploaded resumes are stored on disk
UPLOAD_DIR=./uploaded_resumes
